/ {
	aliases {
		amu = &amu_0;
	};

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;

	amu_0: amu@f {
		compatible = "aerospace,amu";
		reg = <0x0f>;
		status = "okay";
		payload-index = <0>;
		face = "pos-z";
	};
};

&uart0 {
	status = "okay";
};
