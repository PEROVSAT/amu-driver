/ {
	aliases {
		amu = &amu_0;
	};

	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;

	amu_0: amu@f {
		compatible = "aerospace,amu";
		reg = <0x0f>;
		status = "okay";
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
