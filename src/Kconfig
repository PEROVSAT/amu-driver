config PEROVSAT_AMU
	bool "AMU driver"
	depends on DT_HAS_AEROSPACE_AMU_ENABLED
	help
	  Enable the AMU Zephyr driver module.

if PEROVSAT_AMU

choice
	prompt "AMU backend"
	default PEROVSAT_AMU_BACKEND_PUBLIC_MOCK

config PEROVSAT_AMU_BACKEND_HARDWARE
	bool "Hardware (real device over bus)"
	select I2C
	help
	  Link lib/amu.c with src/hardware_transfer.c.

config PEROVSAT_AMU_BACKEND_LIBRARY_MOCK
	bool "Library mock (lib/ without hardware)"
	help
	  Link lib/amu.c with src/lib_mock_transfer.c.

config PEROVSAT_AMU_BACKEND_PUBLIC_MOCK
	bool "Public mock (hardcoded data, no library required)"
	help
	  Link mock/amu.c instead of lib/amu.c.
	  Safe for CI and repos without NDA library access.

endchoice

endif
